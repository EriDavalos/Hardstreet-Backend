# ==========================================================
# Hard Street Backend - Variables de entorno
# ==========================================================

# Postgres (Neon). Formato:
# postgresql://USUARIO:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar el JWT de sesion (cookie httpOnly).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Entorno
NODE_ENV=development
